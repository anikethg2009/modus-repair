# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Resend API key, from https://resend.com/api-keys (starts with "re_").
RESEND_API_KEY=re_your_api_key_here

# Optional. Sender address for repair-request emails. Leave unset to use Resend's
# shared test sender, which can only deliver to your Resend account's own email.
# After verifying your domain in Resend, set something like:
# RESEND_FROM="Modus Repair <requests@yourdomain.com>"

# Optional. Your public site URL, used for SEO tags and the sitemap.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
